# Server-only password-recovery delivery. Copy values to api/.env; never commit it.
RESEND_API_KEY=
RESEND_FROM_EMAIL="SGF-AP <no-reply@your-verified-domain.example>"
PASSWORD_RECOVERY_EMAIL_MODE=provider
PASSWORD_RECOVERY_CODE_TTL_SECONDS=600
PASSWORD_RECOVERY_GRANT_TTL_SECONDS=300
PASSWORD_RECOVERY_MAX_VERIFY_ATTEMPTS=5
PASSWORD_RECOVERY_RESEND_WAIT_SECONDS=60
RESEND_REQUEST_TIMEOUT_SECONDS=10
